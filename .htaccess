# Project root .htaccess - redirects all traffic to /public
# This is for shared hosting where the project root is exposed.
# If your hosting allows you to set the document root to /public directly, do that instead.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|composer\.(json|lock)|README\.md)$ - [F,L]
    RewriteRule ^(app|config|database|routes|storage|resources|cron|queue|docs)(/.*)?$ - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^\.env|\.htaccess|\.htpasswd|\.git|composer\.(json|lock)|package\.json|README\.md$">
    Require all denied
</FilesMatch>
